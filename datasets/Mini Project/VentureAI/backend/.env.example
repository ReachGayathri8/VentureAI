# VentureAI backend - copy to `.env` (or export these as real environment
# variables / -D system properties) before running `mvn spring-boot:run`.
# Every value has a sane local default baked into application.yml, so you
# only need to override what's different on your machine.

# --- Server ---
SERVER_PORT=8080

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ventureai
DB_USERNAME=root
DB_PASSWORD=password
# create | update | validate | none  (use "update" for local dev - it will
# create/alter tables automatically from the JPA entities on first boot)
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Generate a real random 256-bit+ secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=VentureAI_Super_Secret_Key_Change_Me_In_Production_1234567890
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML microservice (Python/FastAPI) ---
ML_SERVICE_BASE_URL=http://localhost:8001

# --- Gemini (optional) ---
# Leave GEMINI_ENABLED=false (default) to run entirely on the built-in
# rule-based analysis engine - no key required, nothing is faked, every
# SWOT/competitor/market/recommendation/risk section is still generated
# from the actual startup data you submit. Set these to switch to live
# Gemini calls once you have a key, with zero code changes.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- PDF report storage ---
REPORTS_STORAGE_DIR=./reports

# --- Logging ---
LOG_LEVEL=INFO
